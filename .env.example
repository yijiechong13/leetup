# LeetUP — LLM provider configuration.
#
# Copy to `.env` and fill in the real values. `.env` is gitignored: never
# commit a real API key.
#
#   cp .env.example .env
#
# The client speaks the OpenAI chat-completions shape, so any OpenAI-compatible
# endpoint works by changing the URL and model name alone.

VITE_LLM_API_KEY=replace_with_api_key
VITE_LLM_API_URL=https://api.example.com/v1/chat/completions
VITE_LLM_MODEL=replace_with_model_name

# true  -> the LLM provider interprets learner answers and words the tutor's turns
# false -> the scripted provider runs the same dialogue deterministically, offline
VITE_USE_LLM=false
